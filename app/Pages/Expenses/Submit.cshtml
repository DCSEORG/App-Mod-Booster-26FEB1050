@page
@model ExpenseManagement.Pages.Expenses.SubmitModel
@{
    ViewData["Title"] = "Submit Expense";
    ViewData["ActivePage"] = "Submit";
}

@if (Model.ServiceError is not null)
{
    <div class="error-bar">
        <div class="error-bar-icon">⚠️</div>
        <div class="error-bar-body">
            <div class="error-bar-title">Error loading form data – using demo values</div>
            <div class="error-bar-msg">
                <strong>Location:</strong> @Model.ServiceError.FileName, line @Model.ServiceError.LineNumber<br />
                <strong>Error:</strong> @Model.ServiceError.Message
            </div>
            @if (Model.ServiceError.ManagedIdentityAdvice is not null)
            {
                <div class="error-bar-advice">💡 <strong>Fix:</strong> @Model.ServiceError.ManagedIdentityAdvice</div>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div style="background:var(--success-light);border:1px solid #6ee7b7;border-radius:8px;padding:1rem 1.25rem;margin-bottom:1.5rem;color:var(--success);">
        ✅ @Model.SuccessMessage
    </div>
}

<div class="card" style="max-width:760px">
    <div class="card-header">
        <h2>New Expense Claim</h2>
    </div>
    <div class="card-body">
        <form method="post">
            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Input.UserId">Employee</label>
                    <select asp-for="Input.UserId" required>
                        <option value="">Select employee…</option>
                        @foreach (var u in Model.Users)
                        {
                            <option value="@u.UserId">@u.UserName (@u.RoleName)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Input.CategoryId">Category</label>
                    <select asp-for="Input.CategoryId" required>
                        <option value="">Select category…</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.CategoryId">@c.CategoryName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Amount (£)</label>
                    <input type="number" name="AmountGBP" step="0.01" min="0.01" placeholder="0.00" required />
                    <span class="form-help">Enter amount in pounds e.g. 25.40</span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ExpenseDate">Expense Date</label>
                    <input asp-for="Input.ExpenseDate" type="date" required />
                </div>
                <div class="form-group full-width">
                    <label asp-for="Input.Description">Description</label>
                    <textarea asp-for="Input.Description" placeholder="Brief description of the expense…"></textarea>
                </div>
                <div class="form-group full-width">
                    <label asp-for="Input.ReceiptFile">Receipt Reference</label>
                    <input asp-for="Input.ReceiptFile" type="text" placeholder="e.g. /receipts/alice/taxi_oct20.jpg" />
                </div>
                <div class="form-group">
                    <label asp-for="Input.StatusId">Submit as</label>
                    <select asp-for="Input.StatusId" required>
                        @foreach (var s in Model.Statuses)
                        {
                            <option value="@s.StatusId">@s.StatusName</option>
                        }
                    </select>
                </div>
            </div>
            <hr class="separator" />
            <div class="page-actions">
                <button type="submit" class="btn btn-primary">Submit Expense</button>
                <a href="/Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
